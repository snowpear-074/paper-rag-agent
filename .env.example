# ==============================================================================
# 环境变量示例文件
#
# 用法：复制为 .env 并在启动前加载（.env 已在 .gitignore 中，不会被提交）
#
#   Linux / macOS:
#       cp .env.example .env      # 填入真实值
#       set -a; source .env; set +a
#       python run.py
#
#   Windows PowerShell:
#       Copy-Item .env.example .env
#       Get-Content .env | ForEach-Object {
#         if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#           Set-Item "env:$($matches[1].Trim())" $matches[2].Trim()
#         }
#       }
#       python run.py
#
# 也可以完全不用本文件，改用密封凭据库（推荐）：
#       python -m src.utils.secrets set llm_api_key
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM 大模型（必填）
# 优先级：环境变量 > 密封凭据库 > config.yaml
# ------------------------------------------------------------------------------
APP_LLM__PROVIDER=openai
APP_LLM__MODEL=deepseek-chat
APP_LLM__BASE_URL=https://api.deepseek.com
APP_LLM__API_KEY=sk-在这里填入你的密钥
APP_LLM__TEMPERATURE=0.3
APP_LLM__MAX_TOKENS=2048
APP_LLM__TIMEOUT=120

# ------------------------------------------------------------------------------
# Embedding 向量化
# 注意：DeepSeek 不提供 embedding 接口（/v1/embeddings 返回 404）。
#       hash   = 内置哈希向量（零依赖，词面近似，默认）
#       ollama = 本地 bge-large-zh（真正的语义向量，推荐；需先 ollama pull）
#       openai = 其他 OpenAI 兼容 embedding 服务（需其自家密钥）
# ------------------------------------------------------------------------------
APP_EMBEDDING__PROVIDER=hash
APP_EMBEDDING__MODEL=bge-large-zh
APP_EMBEDDING__DIMENSION=512
# 若改用 ollama 向量化，取消下面两行注释并把 dimension 改成 1024
# APP_EMBEDDING__BASE_URL=http://127.0.0.1:11434
# APP_EMBEDDING__PROVIDER=ollama

# ------------------------------------------------------------------------------
# 联网搜索
# 抓取式引擎（bing / baidu / duckduckgo）无需密钥；provider=auto 会自动降级。
# 只有 tavily / serper 才需要下面的密钥。
# ------------------------------------------------------------------------------
APP_WEB_SEARCH__ENABLED=true
APP_WEB_SEARCH__PROVIDER=auto
APP_WEB_SEARCH__MAX_RESULTS=5
# APP_WEB_SEARCH__API_KEY=

# ------------------------------------------------------------------------------
# 向量库与检索（可选，用于对比实验调参）
# ------------------------------------------------------------------------------
APP_VECTOR_STORE__BACKEND=numpy
APP_RETRIEVAL__TOP_K=5
APP_RETRIEVAL__CANDIDATE_K=20
APP_RETRIEVAL__ENABLE_BM25=true
APP_RETRIEVAL__ENABLE_RERANK=true
APP_RETRIEVAL__MIN_CONFIDENCE=0.06
APP_RETRIEVAL__LOW_RELEVANCE_THRESHOLD=0.25

# ------------------------------------------------------------------------------
# 分块策略
# fixed | recursive | semantic | paper
# ------------------------------------------------------------------------------
APP_CHUNKING__STRATEGY=paper
APP_CHUNKING__CHUNK_SIZE=512
APP_CHUNKING__CHUNK_OVERLAP=60

# ------------------------------------------------------------------------------
# Agent 行为
# ------------------------------------------------------------------------------
APP_AGENT__MAX_ITERATIONS=8
APP_AGENT__ENABLE_ROUTER=true
APP_AGENT__ENABLE_PARALLEL=true
APP_AGENT__TOOL_TIMEOUT=60

# ------------------------------------------------------------------------------
# 服务端
# ------------------------------------------------------------------------------
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8501

# ------------------------------------------------------------------------------
# 日志
# ------------------------------------------------------------------------------
APP_OBSERVABILITY__LEVEL=INFO
