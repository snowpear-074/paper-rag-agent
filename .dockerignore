# ==============================================================================
# Docker 构建上下文排除规则
# 目的：缩小构建上下文、避免把本机数据与密钥打进镜像
# ==============================================================================

# 版本控制与编辑器
.git
.gitignore
.idea
.vscode
*.swp

# Python 缓存与虚拟环境
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
.mypy_cache
.ruff_cache

# 运行时数据（镜像内会重建空目录）
data/
logs/
reports/

# ⚠️ API 凭据绝不进镜像 —— 运行时用环境变量注入
data/secrets/
*.sealed.json
.env

# 测试（tests/fixtures 由 Dockerfile 单独复制）
tests/
!tests/fixtures/

# 文档原件与草稿
*.docx
*.pdf
_task_doc.txt
_template_doc.txt
_scratch_*.py

# 环境变量（含密钥）
.env
.env.local

# Docker 自身
docker/docker-compose.yml
